# Copia este archivo a .env y completa los valores.

# Firebase — configuración web (Console > Configuración del proyecto > Tus apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Resend — solo se usa en la Vercel Function, sin prefijo VITE_
RESEND_API_KEY=
RESEND_FROM=hola@octalink.cl

# No se necesita FIREBASE_SERVICE_ACCOUNT: la function verifica el ID token
# contra la API REST de Identity Platform usando VITE_FIREBASE_API_KEY
# (evita `firebase-admin`, que rompe el build de Vercel — ver api/send-cobro.ts).
